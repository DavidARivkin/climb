# REQUIRED:

# LLM Provider: openai (default), anthropic, google, groq, ollama, zai, deepseek, together, openrouter, openai_compatible
LLM_PROVIDER="openai"

# --- Provider API keys (set the one(s) you need): ---

# Required if using OpenAI (default):
OPENAI_API_KEY="API_KEY_FOR_OPENAI"

# Required if using Azure OpenAI Service:
AZURE_OPENAI_API_KEY__my-endpoint-1="API_KEY_FOR_AZURE_ENDPOINT_1"
# AZURE_OPENAI_API_KEY__my-endpoint-2="API_KEY_FOR_AZURE_ENDPOINT_2"
# ...

# Required if using Anthropic:
# ANTHROPIC_API_KEY="API_KEY_FOR_ANTHROPIC"

# Required if using Google:
# GOOGLE_API_KEY="API_KEY_FOR_GOOGLE"

# Required if using Groq:
# GROQ_API_KEY="API_KEY_FOR_GROQ"

# Required if using Z.ai (Zyphra):
# ZAI_API_KEY="API_KEY_FOR_ZAI"

# Required if using DeepSeek:
# DEEPSEEK_API_KEY="API_KEY_FOR_DEEPSEEK"

# Required if using Together AI:
# TOGETHER_API_KEY="API_KEY_FOR_TOGETHER"

# Required if using OpenRouter:
# OPENROUTER_API_KEY="API_KEY_FOR_OPENROUTER"

# Required if using OpenAI-compatible (custom endpoint):
# OPENAI_COMPAT_API_KEY="API_KEY_FOR_COMPAT_ENDPOINT"
# OPENAI_COMPAT_BASE_URL="https://your-llm-host.example.com/v1"

# Ollama does not require an API key by default.
# Ensure Ollama is running on http://localhost:11434

# ================================================================================

# OPTIONAL:

# If you are experiencing problems with conda (often "OSError: No such file or directory"),
# you can specify the path to the conda executable here.
# CONDA_PATH="C:\Users\username\Anaconda3\Scripts\conda.exe"
# ^ Set to wherever your conda executable is actually located.

# ================================================================================

# FOR DEVELOPERS:

# Debug panels on the UI.
# "True" or "False":
DEBUG_PANEL="False"
